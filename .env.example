# ==============================================================================
# 1. LLM Provider (выберите один из вариантов ниже)
# ==============================================================================

# Вариант А: Официальный OpenAI (по умолчанию)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL не нужен (OpenAI SDK сам идет на https://api.openai.com/v1)

# Вариант Б: OpenRouter
# OPENAI_API_KEY=sk-or-v1-ваш-ключ-тут
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# Вариант В: DeepSeek
# OPENAI_API_KEY=sk-ваш-ключ-тут
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Вариант Г: Локальная Ollama (бесплатно, без API ключа)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# Database Configuration (Optional ClickHouse)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
